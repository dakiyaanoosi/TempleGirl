# Enforce LF line endings for all text files
* text=auto eol=lf

# Explicitly LF for web source files
*.js   text eol=lf
*.jsx  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.xml  text eol=lf
*.txt  text eol=lf
*.svg  text eol=lf

# Binary — do not mangle
*.webp binary
*.aac  binary
*.png  binary
*.jpg  binary
*.ico  binary
*.woff binary
*.woff2 binary
